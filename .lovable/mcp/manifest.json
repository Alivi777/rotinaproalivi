        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "get_agenda_by_date",
        "title": "Consultar agenda clínica de um dia",
        "description": "Retorna a agenda clínica (consultas) para uma data específica no formato YYYY-MM-DD (timezone America/Sao_Paulo).",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Data no formato YYYY-MM-DD"
            }
          },
          "required": [
            "date"
          ]
        },
        "outputSchema": null
      }
