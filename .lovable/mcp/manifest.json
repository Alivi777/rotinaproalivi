        "name": "list_clients",
        "title": "Listar clientes/pacientes",
        "description": "Retorna os clientes/pacientes cadastrados, filtrando opcionalmente por nome. Limite máximo 100.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {
            "search": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filtro opcional por nome do cliente"
            },
            "limit": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Máximo de resultados (padrão 50)"
            }
          },
          "required": [
            "search",
            "limit"
          ]
        },
        "outputSchema": null
      },
      {
        "name": "list_routine_tasks",
        "title": "Listar tarefas de rotina",
